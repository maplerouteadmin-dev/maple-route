{
  "name": "maple-route-companion",
  "private": true,
  "version": "1.1.0-beta.10",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/copy-ocr.mjs && vite build",
    "test": "node --check src/app.js && node --test src/*.test.js scripts/*.test.mjs desktop/*.test.mjs desktop/*.test.cjs",
    "scan:titles": "node scripts/scan-titles.mjs",
    "audit:handins": "node scripts/audit-handins.mjs",
    "audit:quests": "node scripts/audit-quests.mjs",
    "audit:droppers": "node scripts/audit-droppers.mjs",
    "desktop": "npm run build && electron .",
    "desktop:linux": "npm run build && electron-builder --linux AppImage --x64",
    "test:deck-fixtures": "node scripts/make-deck-fixtures.mjs && node --test desktop/deck-fixtures.test.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "qrcode": "^1.5.4",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "vite": "^7.1.0"
  },
  "license": "MIT",
  "description": "Free second-screen GPS companion for MapleStory Classic World (unofficial; reads only the shared window).",
  "build": {
    "appId": "dev.mapleroute.companion",
    "productName": "Maple Route",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "desktop/**",
      "!desktop/probe/**",
      "scripts/serve.mjs",
      "scripts/osmscache.mjs",
      "scripts/autostart.mjs",
      "package.json"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "artifactName": "Maple-Route-${version}-linux-${arch}.${ext}"
    },
    "asarUnpack": [
      "desktop/*.py"
    ]
  }
}
